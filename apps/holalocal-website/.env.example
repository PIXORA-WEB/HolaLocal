VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SITE_URL=https://holalocal.es

# App Check is monitor-first and initializes only when this is explicitly true.
VITE_FIREBASE_APPCHECK_ENABLED=false
# Public reCAPTCHA Enterprise site key supplied separately per environment.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only: true generates a token, or provide a registered debug token.
# Never configure this variable for Production or public Preview builds.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
