{
  "name": "holalocal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/checkBundleSize.mjs",
    "check:firebase": "node scripts/checkFirebaseInitialization.mjs",
    "check:locales": "node scripts/checkLocales.js",
    "lint": "eslint .",
    "migrate:business-private": "node scripts/migrateBusinessPrivate.js",
    "audit:public-contacts": "node scripts/auditPublicBusinessContacts.js",
    "audit:firebase-readonly": "node scripts/firebaseAudit/cli.js",
    "audit:test-cleanup-readonly": "node scripts/testDataCleanupAudit/cli.js",
    "audit:contact-privacy-repair-readonly": "node scripts/contactPrivacyRepairAudit/cli.js",
    "repair:contact-privacy-controlled": "node scripts/contactPrivacyRepairExecution/cli.js",
    "cleanup:test-data-controlled": "node scripts/testDataCleanupExecution/cli.js",
    "test:audit": "node --test tests/firebaseAudit.test.mjs",
    "test:cleanup-audit": "node --test tests/testDataCleanupAudit.test.mjs",
    "test:cleanup-execution": "node --test tests/testDataCleanupExecution.test.mjs",
    "test:contact-privacy-repair": "node --test tests/contactPrivacyRepairAudit.test.mjs",
    "test:contact-privacy-execution": "node --test tests/contactPrivacyRepairExecution.test.mjs",
    "test:contact-privacy-rollout": "node --test tests/contactPrivacyRollout.test.mjs",
    "optimize:images": "node scripts/optimizeImages.mjs",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --project demo-holalocal-rules --only firestore,storage \"node --test tests/rules.test.mjs\"",
    "test:compatibility": "node --test tests/compatibility.test.mjs",
    "test:admin-browser": "node tests/browser/runAdminBrowserSmoke.mjs",
    "preview:admin-browser": "node tests/browser/runAdminBrowserPreview.mjs"
  },
  "dependencies": {
    "@holalocal/firebase-contract": "file:../../shared/firebase-contract",
    "firebase": "^12.15.0",
    "i18next": "^26.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.12.1",
    "globals": "^17.0.0",
    "vite": "^8.0.0"
  }
}
