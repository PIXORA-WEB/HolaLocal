{
  "name": "holalocal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle": "node scripts/checkBundleSize.mjs",
    "check:firebase": "node scripts/checkFirebaseInitialization.mjs",
    "check:locales": "node scripts/checkLocales.js",
    "lint": "eslint .",
    "migrate:business-private": "node scripts/migrateBusinessPrivate.js",
    "audit:public-contacts": "node scripts/auditPublicBusinessContacts.js",
    "optimize:images": "node scripts/optimizeImages.mjs",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config ../../firebase.json --project demo-holalocal-rules --only firestore,storage \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "i18next": "^26.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.12.1",
    "globals": "^17.0.0",
    "vite": "^8.0.0"
  }
}
